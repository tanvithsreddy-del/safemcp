---
import stats from "../data/stats.json";
const placeholder = `Search ${stats.total.toLocaleString()} servers by name, owner, function, or category`;
---
<form action="/search" method="get" class="search-input" role="search" data-searchbox>
  <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="7"/><path d="M21 21l-3.5-3.5"/>
  </svg>
  <input type="search" name="q" placeholder={placeholder} aria-label="Search MCP servers" autocomplete="off" />
</form>
