---
import { SHOW_SPONSORS } from "../lib/flags";
---
<header>
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="mono">safemcp</span><span class="dim mono">.info</span>
    </a>
    <nav class="nav">
      <a href="/browse">Browse</a>
      <a href="/about">About</a>
      {SHOW_SPONSORS && <a href="/sponsors">Sponsor</a>}
      <button id="theme-toggle" aria-label="Toggle theme" class="theme-toggle">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 0.5px solid var(--border-subtle);
    background: var(--bg-page);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
  }
  .logo {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
  }
  .logo:hover { color: var(--text-primary); }
  .dim { color: var(--text-tertiary); }
  .nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav a {
    color: var(--text-secondary);
    font-size: 13px;
    text-decoration: none;
  }
  .nav a:hover { color: var(--text-primary); }

  .theme-toggle {
    background: transparent;
    border: 0;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
  }
  .theme-toggle:hover { color: var(--text-primary); }
  :root[data-theme="dark"] .theme-toggle .sun { display: none; }
  :root[data-theme="light"] .theme-toggle .moon { display: none; }

  @media (max-width: 600px) {
    .nav { gap: 14px; }
    .nav a { font-size: 12px; }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem("safemcp-theme", next); } catch (e) {}
    });
  });
</script>
