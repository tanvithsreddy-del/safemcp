---
import Base from "../../../layouts/Base.astro";
import ScoreBadge from "../../../components/ScoreBadge.astro";
import ServerRow from "../../../components/ServerRow.astro";
import InstallSnippet from "../../../components/InstallSnippet.astro";
import { computeScoreBreakdown } from "../../../lib/score";
import { freshness } from "../../../lib/runtime";
import type { Server } from "../../../lib/data";

// This page is dynamic — it queries D1 at request time.
// Cloudflare edge caches the response for 24h via Cache-Control headers below.
// The top ~3000 servers will sit in edge cache and perform like static HTML.
export const prerender = false;

const { owner, name } = Astro.params;

if (!owner || !name) {
  return new Response("Bad request", { status: 400 });
}

const db: any = (Astro.locals as any)?.runtime?.env?.DB;

let server: Server | null = null;
let similar: Server[] = [];
let dbAvailable = !!db;

if (db) {
  try {
    const row = await db
      .prepare("SELECT data FROM servers WHERE owner = ? AND name = ?")
      .bind(owner, name)
      .first();
    if (row?.data) {
      server = JSON.parse(row.data as string) as Server;

      // Similar: top 5 in same category, excluding this one.
      const cat = server.mcp_category || "unknown";
      const sim = await db
        .prepare(
          `SELECT data FROM servers
           WHERE category = ?
             AND NOT (owner = ? AND name = ?)
           ORDER BY score DESC LIMIT 5`
        )
        .bind(cat, owner, name)
        .all();
      similar = (sim?.results || []).map((r: any) => JSON.parse(r.data));
    }
  } catch (e) {
    // D1 query failure — fall through to 404.
  }
}

// Not found OR D1 unavailable — return a 404 response. Cloudflare will serve
// our 404.astro static asset for this status code thanks to the assets routing.
if (!server) {
  return new Response("Not found", {
    status: 404,
    headers: { "Cache-Control": "public, max-age=60" },
  });
}

// Cache hot at the edge for 24h, but let browsers re-check every 5min.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400"
);

const stars = (server.stars ?? 0).toLocaleString();
const forks = (server.forks ?? 0).toLocaleString();
const tags = (server.mcp_tags || "").split(",").map((t) => t.trim()).filter(Boolean);
const sources = (server.sources || "").split(",").map((t) => t.trim()).filter(Boolean);
const description =
  server.description ||
  server.primary_function ||
  `${server.owner}/${server.name} — MCP server`;
const breakdown = computeScoreBreakdown(server);
const fresh = freshness(server);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `${server.owner}/${server.name}`,
  "description": description,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": server.runtime || "Cross-platform",
  "url": server.repo_url,
  "codeRepository": server.repo_url,
  "applicationSubCategory": `MCP Server (${server.mcp_category || "uncategorized"})`,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": ((server.recommended_score ?? 0) / 20).toFixed(1),
    "bestRating": "5",
    "ratingCount": Math.max(1, server.stars ?? 1),
  },
};
---
<Base title={`${server.owner}/${server.name} — SafeMCP`} description={description} jsonLd={jsonLd}>
  <p class="muted small">
    <a href="/browse">Browse</a> · <a href={`/category/${server.mcp_category || "unknown"}/`}>{server.mcp_category || "unknown"}</a>
  </p>

  <div class="header">
    <ScoreBadge score={server.recommended_score} />
    <div>
      <h1 class="mono repo">
        <a href={server.repo_url} target="_blank" rel="noopener">
          {server.owner}<span class="dim">/</span>{server.name}
        </a>
      </h1>
      <p class="muted small mono" style="margin: 4px 0 0;">
        ★ {stars} · forks {forks}
        {server.runtime && <> · runtime <span class="mono">{server.runtime}</span></>}
        {server.requires_api_key !== null && server.requires_api_key !== undefined && (
          <> · {server.requires_api_key ? "requires API key" : "no API key"}</>
        )}
        {fresh && <> · updated <span class="mono">{fresh}</span></>}
      </p>
    </div>
  </div>

  {server.primary_function && (
    <p class="lede">{server.primary_function}</p>
  )}

  {server.description && server.description !== server.primary_function && (
    <p class="desc-block">{server.description}</p>
  )}

    {/* Phase 1 — claim/verify */}
  <div style="margin: 12px 0; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
    <span class="verified-pill" data-verified-for={`${server.owner}/${server.name}`} hidden>
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.78 6.28-4.5 4.5a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 1 1 1.06-1.06L6.75 9.19l3.97-3.97a.75.75 0 1 1 1.06 1.06Z"/></svg>
      Verified by owner
    </span>
    <a class="claim-cta" href={`/api/auth/github?serverId=${encodeURIComponent(server.owner + "/" + server.name)}`} data-claim-for={`${server.owner}/${server.name}`} rel="nofollow">Claim this server &rarr;</a>
  </div>

  <p style="margin: 16px 0;"><a href={server.repo_url} target="_blank" rel="noopener">View on GitHub →</a></p>

  <InstallSnippet server={server} />

  <p class="eyebrow">Recommended Score breakdown</p>
  <div class="breakdown">
    {breakdown.map((c) => (
      <div class="breakdown-row">
        <div>
          <span class="breakdown-label">{c.label}</span>
          <div class="help">{c.help}</div>
        </div>
        <div class="breakdown-value">{c.value} / {c.max}</div>
      </div>
    ))}
    <div class="breakdown-row" style="border-top: 0.5px solid var(--border-default); padding-top: 10px; margin-top: 4px;">
      <span class="breakdown-label" style="font-weight: 500;">Total</span>
      <span class="breakdown-value" style="font-weight: 500;">{server.recommended_score ?? 0} / 100</span>
    </div>
  </div>

  {tags.length > 0 && (
    <>
      <p class="eyebrow">Tags</p>
      <div class="tags">
        {tags.map((t) => <span class="tag mono">{t}</span>)}
      </div>
    </>
  )}

  {sources.length > 0 && (
    <p class="muted small" style="margin-top: 16px;">
      <span class="dim">Indexed from:</span>{" "}
      {sources.map((s, i) => (
        <>{i > 0 && ", "}<code class="mono">{s}</code></>
      ))}
    </p>
  )}

  {similar.length > 0 && (
    <>
      <p class="eyebrow" style="margin-top: 32px;">Similar in {server.mcp_category || "unknown"}</p>
      <div class="row-list">
        {similar.map((s) => <ServerRow server={s} />)}
      </div>
    </>
  )}

  <p class="disclaimer">
    The Recommended Score reflects metadata quality and popularity — it does not measure code quality, supply-chain safety, malware, or vulnerabilities. Review code before connecting this MCP server.
  </p>
</Base>

<style>
  .small { font-size: 12px; }
  .header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin: 16px 0 12px;
  }
  .repo { font-size: 22px; margin: 0; font-weight: 500; }
  .repo a { color: var(--text-primary); text-decoration: none; }
  .repo a:hover { color: var(--link); }
  .repo .dim { color: var(--text-tertiary); }
  .lede {
    font-size: 15px;
    color: var(--text-primary);
    margin: 16px 0 0;
    line-height: 1.6;
  }
  .desc-block {
    color: var(--text-secondary);
    font-size: 13px;
    margin: 8px 0 0;
    line-height: 1.6;
  }
  .help {
    font-size: 11px;
    color: var(--text-tertiary);
    margin-top: 2px;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    background: var(--bg-surface);
    border: 0.5px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 3px 8px;
    font-size: 11px;
    border-radius: var(--radius-sm);
  }
</style>
